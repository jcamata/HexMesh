# topo file
# topo = ./input/MaunaLoaGEBCO_topo.gts 
topo = ./input/ArgostoliGEBCO_topo.gts
# topo = ./input/JapanEBCO_topo.gts
# topo = ./input/Lore_topography.gts 
# topo = ./input/GiensVadim_topo.gts
# topo = ./input/plane_z10.gts
# number of interfaces
interfaceNumber = 2
inter = ./input/ArgostoliGEBCO_bathy.gts
inter = ./input/flat_layer_z-50000.gts

# refinement level
ref = 4 # the mesh is a cube with 2*3^ref elements in x and y coord
# example : ref = 3, nel = 91,044
# example : ref = 4, nel = 888,732
# example : ref = 5, nel = 8,079,264

# depth of the model
z = 100000
# it should be function in the near future
# the depth for changes from 3->1 elements 
zcuts = 10000; 30000; 40000 

# move nodes in smart octree 
movingNodes = 1 # zero to dont apply and 1 to apply

# Material definition
# number of materials
nmat = 3
#define material 1
S 6300 2300 5000 #solid vp(m/s) vs(m/s) rho(kg/m^3)
#define material 2
S 7000 3500 5500 #solid vp(m/s) vs(m/s) rho(kg/m^3)
#define mateial 3
F 1500 0 1000 #fluid vp(m/s) vs(m/s) rho(kg/m^3)

#PML def
PML = 0 # boolean 1-pml 0-no pml
#set number of layers and width in x
pmlx = 15000
nlayersx = 5
#set number of layers and width in y
pmly = 15000
nlayersy = 5
#set number of layers and width in z
pmlz = 15000
nlayersz = 5
# power and amplitude of the pml
A = 10
npow = 2

#set mesh optimization
meshOpt = 0 #false, it should be implemented in the future

#use exact cgal kernel to find interections set 1 or use gts set 0
CgalUse = 0
