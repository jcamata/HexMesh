# topo file
topo = ./input/ArgostoliGEBCO_topo.gts
# topo = ./input/plane_z10.gts
# number of interfaces
interfaceNumber = 1 #only zero or one interface is admitted now
inter = ./input/ArgostoliGEBCO_bathy.gts
# inter = ./input/plane_z5.gts
# it should change when more than one interface is allowed

# refinement level
ref = 4

# depth of the model
z = 75000
# in the future it gonna have the depth of the changes from 3->1 elements
zcuts = 4000; 5000; 20000 # ref - 1 numbers here, they are the thickness of the layer

# move nodes in smart octree 
movingNodes = 1 # zero to dont apply and 1 to apply

# Material definition
# number of materials
nmat = 1
#define material 1
S 6300 2300 5000 #solid vp(m/s) vs(m/s) rho(kg/m^3)
#define mateial 2
F 1500 0 1000 #fluid vp(m/s) vs(m/s) rho(kg/m^3)

#PML def
PML = 1 # boolean 1-pml 0-no pml
#set number of layers and width in x
pmlx = 15000
nlayersx = 5
#set number of layers and width in y
pmly = 15000
nlayersy = 5
#set number of layers and width in z
pmlz = 15000
nlayersz = 5
# power and amplitude of the pml
A = 10
npow = 2

#set mesh optimization
meshOpt = 0 #false, it should be implemented in the future
