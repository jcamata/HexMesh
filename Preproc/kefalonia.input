# =====================================================================
# Preproc Input Configuration - Kefalonia Region (Greece)
# =====================================================================

# Bounding Box for Kefalonia (Lat/Lon degrees)
# Bounds: [38°00' 39°00' 20°00' 21°00']
lat_min = 38.0
lat_max = 39.0
lon_min = 20.0
lon_max = 21.0

# Feature Filtering & Bathymetry Floor (in meters)
h_min_feature = 1000.0
coastline_tolerance = 100.0
z_min = -200.0

# Data Files & Direct HTTP Download URLs
nc_file = kefalonia_gebco.nc
gebco_url = https://coastwatch.pfeg.noaa.gov/erddap/griddap/ETOPO_2022_v1_15s.nc?z[({lat_min}):1:({lat_max})][({lon_min}):1:({lon_max})]

coastline_file = gshhg/GSHHS_shp/f/GSHHS_f_L1.shp
coastline_url = https://www.soest.hawaii.edu/pwessel/gshhg/gshhg-shp-2.3.7.zip

# Hydrography Feature Toggles
include_coastline = true
include_lakes = true
include_rivers = false
include_dams = false

# Geological Velocity Model (PREM)
geology_model = PREM
material_output_file = kefalonia_material.input

# Output Surface Mesh File Names
bathymetry_gts = kefalonia_bathymetry.gts
bathymetry_stl = kefalonia_bathymetry.stl
bathymetry_vtk = kefalonia_bathymetry.vtk

topography_gts = kefalonia_topography.gts
topography_stl = kefalonia_topography.stl
topography_vtk = kefalonia_topography.vtk
