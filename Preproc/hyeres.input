# =====================================================================
# Preproc Input Configuration - Hyères Region (France)
# =====================================================================

# Bounding Box for Hyères Region (Lat/Lon degrees)
# Bounds: [42.920641, 43.203211, 5.866964, 6.612617]
lat_min = 42.920641
lat_max = 43.203211
lon_min = 5.866964
lon_max = 6.612617

# Feature Filtering & Bathymetry Floor (in meters)
h_min_feature = 1.0
coastline_tolerance = 1.0
z_min = -10.0

# Data Files & Direct HTTP Download URLs
nc_file = hyeres_gebco.nc
gebco_url = https://coastwatch.pfeg.noaa.gov/erddap/griddap/ETOPO_2022_v1_15s.nc?z[({lat_min}):1:({lat_max})][({lon_min}):1:({lon_max})]

coastline_file = gshhg/GSHHS_shp/f/GSHHS_f_L1.shp
coastline_url = https://www.soest.hawaii.edu/pwessel/gshhg/gshhg-shp-2.3.7.zip

# Hydrography Feature Toggles
include_coastline = true
include_lakes = true
include_rivers = false
include_dams = false

# Geological Velocity Model (PREM)
geology_model = PREM
material_output_file = hyeres_material.input

# Output Surface Mesh File Names
bathymetry_gts = hyeres_bathymetry.gts
bathymetry_stl = hyeres_bathymetry.stl
bathymetry_vtk = hyeres_bathymetry.vtk

topography_gts = hyeres_topography.gts
topography_stl = hyeres_topography.stl
topography_vtk = hyeres_topography.vtk
