# =====================================================================
# Preproc Input Configuration - Cadarache Region (France)
# =====================================================================

# Bounding Box for Cadarache (Lat/Lon degrees)
# Bounds: [43°40' 44°00' 5°30' 6°00']
lat_min = 43.666667
lat_max = 44.0
lon_min = 5.5
lon_max = 6.0

# Feature Filtering & Bathymetry Floor (in meters)
h_min_feature = 1000.0
coastline_tolerance = 100.0
z_min = -200.0

# Data Files & Direct HTTP Download URLs
nc_file = cadarache_gebco.nc
gebco_url = https://coastwatch.pfeg.noaa.gov/erddap/griddap/ETOPO_2022_v1_15s.nc?z[({lat_min}):1:({lat_max})][({lon_min}):1:({lon_max})]

coastline_file = gshhg/GSHHS_shp/f/GSHHS_f_L1.shp
coastline_url = https://www.soest.hawaii.edu/pwessel/gshhg/gshhg-shp-2.3.7.zip

# Hydrography Feature Toggles
include_coastline = true
include_lakes = true
include_rivers = false
include_dams = false

# Geological Velocity Model (PREM)
geology_model = PREM
material_output_file = cadarache_material.input

# Output Surface Mesh File Names
bathymetry_gts = cadarache_bathymetry.gts
bathymetry_stl = cadarache_bathymetry.stl
bathymetry_vtk = cadarache_bathymetry.vtk

topography_gts = cadarache_topography.gts
topography_stl = cadarache_topography.stl
topography_vtk = cadarache_topography.vtk
