# =====================================================================
# Preproc Input Configuration - Test Small Mauna Loa Region (Hawaii)
# =====================================================================

# Bounding Box for Test Small Mauna Loa (Lat/Lon degrees)
# Bounds: [20°00' 21°00' -156°00' -155°00']
lat_min = 20.0
lat_max = 21.0
lon_min = -156.0
lon_max = -155.0

# Feature Filtering & Bathymetry Floor (in meters)
h_min_feature = 1000.0
coastline_tolerance = 100.0
z_min = -100.0

# Data Files & Direct HTTP Download URLs
nc_file = mauna_loa_small_gebco.nc
gebco_url = https://coastwatch.pfeg.noaa.gov/erddap/griddap/ETOPO_2022_v1_15s.nc?z[({lat_min}):1:({lat_max})][({lon_min}):1:({lon_max})]

coastline_file = gshhg/GSHHS_shp/f/GSHHS_f_L1.shp
coastline_url = https://www.soest.hawaii.edu/pwessel/gshhg/gshhg-shp-2.3.7.zip

# Hydrography Feature Toggles
include_coastline = true
include_lakes = true
include_rivers = false
include_dams = false

# Geological Velocity Model (PREM)
geology_model = PREM
material_output_file = mauna_loa_small_material.input

# Output Surface Mesh File Names
bathymetry_gts = mauna_loa_small_bathymetry.gts
bathymetry_stl = mauna_loa_small_bathymetry.stl
bathymetry_vtk = mauna_loa_small_bathymetry.vtk

topography_gts = mauna_loa_small_topography.gts
topography_stl = mauna_loa_small_topography.stl
topography_vtk = mauna_loa_small_topography.vtk
