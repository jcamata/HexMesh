# Topography file
topo = ./input/mauna_loa_topography.gts

# Bathymetry & Deep Interfaces
interfaceNumber = 1
inter = ./input/mauna_loa_bathymetry.gts

# Refinement level
ref = 3

# Depth of the model
z = 100000
zcuts = 10000; 30000; 40000 

# Move nodes in smart octree
movingNodes = 1

# Material definition
nmat = 3
S 5800 3200 2600
S 6800 3900 2900
F 1450 0 1020

# PML definition
PML = 0
pmlx = 15000
nlayersx = 5
pmly = 15000
nlayersy = 5
pmlz = 15000
nlayersz = 5
A = 10
npow = 2

# Mesh optimization
meshOpt = 1
CgalUse = 0

# Spectral Element GLL Quadrature Order (1 to 20)
gll_order = 4
